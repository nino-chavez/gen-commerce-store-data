{
  "name": "@signalx/seed-toolkit",
  "version": "2.0.0",
  "description": "Multi-platform e-commerce test data seeder — generates products, customers, orders, and coupons for WooCommerce and BigCommerce",
  "type": "module",
  "bin": {
    "seed": "./bin/seed",
    "wc-seed": "./bin/wc-seed"
  },
  "scripts": {
    "start": "node bin/seed",
    "seed:all": "node bin/seed all",
    "seed:products": "node bin/seed products",
    "seed:customers": "node bin/seed customers",
    "seed:orders": "node bin/seed orders",
    "seed:coupons": "node bin/seed coupons",
