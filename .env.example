# Platform selection: wc, bc, or shopify
PLATFORM=wc

# WooCommerce REST API credentials
WC_URL=https://your-store.example.com
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# BigCommerce REST API credentials
BC_STORE_HASH=your_store_hash
BC_ACCESS_TOKEN=your_access_token

# Shopify Admin API credentials
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token

# Shopify OAuth (optional — only needed for `seed auth` to mint a token)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
